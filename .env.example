# PostgreSQL connection string. Local SQLite is supported as a migration source.
DATABASE_URL=postgresql://projectflow:change-this-password@localhost:5432/projectflow

# Generate a unique random value for each deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret
GEMINI_API_KEY=your-gemini-api-key
APP_ENV=development
FRONTEND_URL=http://localhost:8000
